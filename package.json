{
  "name": "overlay-event",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "npm run dev --prefix frontend",
    "start": "tsx src/server.ts",
    "build": "npm run build --prefix frontend && tsc",
    "test:collector": "tsx src/collector.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
